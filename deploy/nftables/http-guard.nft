# Only this table is replaced. Unpopulated/expired LAN set means Tailscale only.
destroy table inet ingecon_http_portal
table inet ingecon_http_portal {
    comment "ingecon-control HTTP guard v1"
    set lan_v4 {
        type ifname . ipv4_addr . ipv4_addr
        flags interval,timeout
        timeout 15s
        gc-interval 5s
        # LAN_ELEMENTS
    }
    chain input {
        type filter hook input priority -10; policy accept;
        iifname "lo" tcp dport 80 accept
        iifname "tailscale0" tcp dport 80 accept
        tcp dport 80 fib saddr . iif oif exists fib daddr type local iifname . ip saddr . ip daddr @lan_v4 accept
        tcp dport 80 counter drop
    }
}
